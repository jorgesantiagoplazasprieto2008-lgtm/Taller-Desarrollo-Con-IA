# CONFIGURACIÓN DEL SERVIDOR
PORT=3000
NODE_ENV=development
APP_NAME="Entre Copas - Plataforma de gestión, trazabilidad y comercialización de bebidas artesanales"

# CONFIGURACIÓN DE BASE DE DATOS MYSQL (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
